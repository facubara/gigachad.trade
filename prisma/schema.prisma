// Prisma schema for GIGACHAD leaderboard

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Player data persisted in database
model Player {
  id              String   @id @default(uuid())
  displayName     String
  totalPushups    Int      @default(0)
  pushupsPerSecond Int     @default(0)
  perks           Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([totalPushups(sort: Desc)])
}

// Cached leaderboard snapshot (refreshed every 24h)
model LeaderboardEntry {
  id               Int      @id @default(autoincrement())
  rank             Int
  playerId         String
  displayName      String
  totalPushups     Int
  pushupsPerSecond Int
  snapshotId       String   // Groups entries by snapshot
  createdAt        DateTime @default(now())

  @@index([snapshotId, rank])
}

// Tracks leaderboard refresh metadata
model LeaderboardMeta {
  id            String   @id @default("current")
  snapshotId    String   @unique
  lastRefreshed DateTime
  totalPlayers  Int
}

// Anonymous wallet stats for entry price analytics
model WalletStats {
  id                    String   @id @default(uuid())
  walletHash            String   @unique  // SHA256 hash for privacy
  totalBuyCount         Int      @default(0)
  totalSellCount        Int      @default(0)
  weightedAvgEntryPrice Float    @default(0)
  uniqueBuyDays         Int      @default(0)
  currentHoldings       Float    @default(0)
  analyzedAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([weightedAvgEntryPrice])
}

// Global aggregated stats for percentile comparisons
model GlobalStats {
  id                   String   @id @default("current")
  totalWalletsAnalyzed Int      @default(0)
  entryPriceP25        Float?
  entryPriceP50        Float?   // Median
  entryPriceP75        Float?
  avgEntryPrice        Float?
  lastUpdated          DateTime @default(now())
}
